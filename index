const SV={ed:null,vars:[],vals:{},lower:-1e99,upper:1e99,idx:0,top:0,sub:null,res:null};
const SUP={2:'²',3:'³',4:'⁴',5:'⁵',6:'⁶'};
/* the formula line the real calculator shows under the grid: anX+bnY=cn / aX²+bX+c=0 */
function eqSegs(g){const n=EQ.n;
  if(EQ.kind==='siml'){const r=g.r+1,co='abcdefg',vn='XYZTUV',segs=[];
    for(let k=0;k<n;k++)segs.push({t:(k?'+':'')+co[k]+r+vn[k],col:k});
    segs.push({t:'='+co[n]+r,col:n});return segs}
  const co='abcdefg',d=n-1,segs=[];
  for(let k=0;k<=d;k++){const e=d-k;segs.push({t:(k?'+':'')+co[k]+(e>=1?'X':'')+(e>=2?SUP[e]:''),col:k})}
  segs.push({t:'=0',col:-1});return segs}
function eqFormula(g){const segs=eqSegs(g);let pos=0;segs.forEach(sg=>{sg.at=pos;pos+=chars(sg.t).length});
  const total=pos,cur=segs.find(sg=>sg.col===g.c)||segs[0];
  const st=total<=21?0:Math.max(0,Math.min(total-21,cur.at-3));
  segs.forEach(sg=>txt(sg.at-st,5,sg.t,sg.col===g.c))}
function eqGrid(){const s=EQ.kind==='siml',rows=s?EQ.n:1,cols=EQ.n+1;EQ.M=Array.from({length:rows},()=>Array(cols).fill(0));
  EQ.grid=mkGrid({nCols:()=>cols,nRows:()=>rows,colLabel:cc=>'abcdefg'[cc],rowLabel:r=>s?String(r+1):'',get:(r,cc)=>EQ.M[r][cc],set:(r,cc,v)=>{EQ.M[r][cc]=v},adv:'right',fkeys:['SOLV','','CLR'],vis:4,formula:eqFormula});EQ.scr='grid'}
/* ----- Solver: Newton-Raphson on f(v) = left side - right side ----- */
function svSplit(toks){const i=toks.indexOf('=');
  const lhs=i<0?toks:toks.slice(0,i),rhs=i<0?['0']:toks.slice(i+1);
  if(i>=0&&toks.indexOf('=',i+1)>=0)SE();if(!lhs.length||!rhs.length)SE();return[lhs,rhs]}
function svOpen(){const toks=SV.ed.toks;svSplit(toks);
  const vs=[...new Set(toks.filter(t=>/^[A-Z]$/.test(t)))].sort();if(!vs.length)SE();
  SV.vars=vs;SV.vals={};vs.forEach(v=>{SV.vals[v]=num(G.vars[v])});SV.lower=-1e99;SV.upper=1e99;SV.idx=0;SV.top=0;SV.sub=null;EQ.scr='svar'}
const svRows=()=>SV.vars.length+2;
function svGet(k){return k<SV.vars.length?SV.vals[SV.vars[k]]:k===SV.vars.length?SV.lower:SV.upper}
function svSet(k,v){if(k<SV.vars.length)SV.vals[SV.vars[k]]=v;else if(k===SV.vars.length)SV.lower=v;else SV.upper=v}
function svLabel(k){return k<SV.vars.length?SV.vars[k]:k===SV.vars.length?'Lower':'Upper'}
function svSolve(){const name=SV.vars[SV.idx];
  const[lhs,rhs]=svSplit(SV.ed.toks),keep={};SV.vars.forEach(v=>{keep[v]=G.vars[v];G.vars[v]=SV.vals[v]});
  try{
    const f=x=>{G.vars[name]=x;return num(evalG(lhs))-num(evalG(rhs))};
    const lo=SV.lower,hi=SV.upper,cl=x=>Math.max(lo,Math.min(hi,x));
    let x=cl(SV.vals[name]),ok=false;
    for(let it=0;it<100;it++){
      const fx=f(x);if(!isFinite(fx))ME();
      if(fx===0){ok=true;break}
      const h=1e-7*Math.max(1,Math.abs(x));let d=(f(x+h)-f(x-h))/(2*h);
      if(!isFinite(d))ME();
      if(Math.abs(d)<1e-300){x=cl(x+(it%2?1:-1)*(1+Math.abs(x))*1e-3*(it+1));continue}
      const nx=cl(x-fx/d),dx=Math.abs(nx-x);x=nx;
      if(dx<=1e-14*(1+Math.abs(x))&&Math.abs(f(x))<=1e-9*(1+Math.abs(fx))){ok=true;break}
      if(dx<=1e-14*(1+Math.abs(x))){ok=Math.abs(f(x))<1e-9;break}}
    if(!ok)throw new CalcError('Time Out');
    const L=num(evalG((G.vars[name]=x,lhs))),R=num(evalG(rhs));
    SV.vals[name]=x;SV.res={name,x,L,R};SV.top=0;EQ.scr='sres'}
  finally{SV.vars.forEach(v=>{G.vars[v]=keep[v]})}}
APPS.EQUA={
  open(){EQ.scr='top'},
  draw(){
    if(EQ.scr==='top'){txt(0,0,'Equation');txt(0,2,'Select Type');txt(0,3,'F1:Simultaneous');txt(0,4,'F2:Polynomial');txt(0,5,'F3:Solver');fk(['SIML','POLY','SOLV'])}
    else if(EQ.scr==='n'){txt(0,0,EQ.kind==='siml'?'Simul Equation':'Polynomial');txt(0,2,EQ.kind==='siml'?'Number Of Unknowns?':'Degree?');fk(['2','3','4','5','6'])}
    else if(EQ.scr==='grid'){drawGrid(EQ.grid);}
    else if(EQ.scr==='seq'){txt(0,0,'Equation Solver');txt(0,2,'Eq:');drawEd(SV.ed,3,2,18);fk(['','','','','',''])}
    else if(EQ.scr==='svar'){const nr=svRows();SV.top=Math.max(0,Math.min(SV.top,nr-6));if(SV.idx<SV.top)SV.top=SV.idx;if(SV.idx>SV.top+5)SV.top=SV.idx-5;
      txt(0,0,('Eq:'+edStr(SV.ed)).slice(0,21));
      for(let i=0;i<6&&SV.top+i<nr;i++){const k=SV.top+i,lab=svLabel(k)+'=';
        if(SV.sub&&k===SV.idx){txt(0,1+i,lab);drawEd(SV.sub,lab.length,1+i,21-lab.length)}
        else txt(0,1+i,(lab+nfmt(svGet(k))).padEnd(21).slice(0,21),k===SV.idx)}
      fk(['','','','','','SOLV'])}
    else if(EQ.scr==='sres'){const r=SV.res;txt(0,0,'Solve');txt(0,1,(r.name+'='+nfmt(r.x)).slice(0,21),true);
      txt(0,3,('Lft='+nfmt(r.L)).slice(0,21));txt(0,4,('Rgt='+nfmt(r.R)).slice(0,21));fk(['REPT'])}
    else drawLines(EQ.view)},
  key(ev){const m=/^F([1-6])$/.exec(ev);
    if(EQ.scr==='top'){if(ev==='F1'||ev==='F2'){EQ.kind=ev==='F1'?'siml':'poly';EQ.scr='n'}else if(ev==='F3'){if(!SV.ed)SV.ed=mkEd();EQ.scr='seq'}}
    else if(EQ.scr==='n'){if(m&&+m[1]<=5){EQ.n=+m[1]+1;eqGrid()}else if(ev==='EXIT')EQ.scr='top'}
    else if(EQ.scr==='seq'){if(ev==='EXIT')EQ.scr='top';else if(ev==='AC')SV.ed=mkEd();else if(ev==='EXE'){if(SV.ed.toks.length)svOpen()}else edKey(SV.ed,ev)}
    else if(EQ.scr==='svar'){
      if(SV.sub){if(ev==='EXE'){const v=num(evalG(SV.sub.toks));svSet(SV.idx,v);SV.sub=null;SV.idx=Math.min(svRows()-1,SV.idx+1)}
        else if(ev==='AC'||ev==='EXIT')SV.sub=null;else edKey(SV.sub,ev);return}
      if(ev.startsWith('t:')){SV.sub=mkEd();edKey(SV.sub,ev)}
      else if(ev==='UP')SV.idx=Math.max(0,SV.idx-1);else if(ev==='DOWN'||ev==='EXE')SV.idx=Math.min(svRows()-1,SV.idx+1);
      else if(ev==='F6'){if(SV.idx>=SV.vars.length)throw new CalcError('Syntax ERROR');svSolve()}
      else if(ev==='EXIT')EQ.scr='seq'}
    else if(EQ.scr==='sres'){if(ev==='EXIT'||ev==='F1')EQ.scr='svar'}
    else if(EQ.scr==='grid'){if(gridKey(EQ.grid,ev))return;
      if(ev==='EXIT')EQ.scr='n';else if(ev==='F3'){EQ.M.forEach(r=>r.fill(0))}
      else if(ev==='F1'){let lines;
        if(EQ.kind==='siml'){let sol;try{sol=solveLinear(EQ.M)}catch(e){throw new CalcError('Ma ERROR')}lines=sol.map((v,k)=>('XYZTUV'[k]+'='+nfmt(v)).slice(0,21))}
        else lines=polyRoots(EQ.M[0]).map((z,k)=>('x'+(k+1)+'='+nfmt(z.re)+(z.im?(z.im<0?'-':'+')+nfmt(Math.abs(z.im))+'i':'')).slice(0,21));
        EQ.view=mkLines(lines,['REPT']);EQ.scr='res'}}
    else{if(ev==='EXIT'||ev==='F1')EQ.scr='grid';else linesKey(EQ.view,ev)}}};
/* ---------- SET UP ---------- */
const SU={row:0};
const SROWS=[['Angle',()=>({D:'Deg',R:'Rad',G:'Gra'}[G.angle]),['Deg','Rad','Gra']],['Display',()=>G.fmt.type+G.fmt.n,['Fix','Sci','Norm']]];
APPS.SETUP={
  draw(){SROWS.forEach((r,k)=>txt(0,k,(r[0].padEnd(11)+':'+r[1]()).padEnd(21),k===SU.row));fk(SROWS[SU.row][2])},
  key(ev){if(ev==='UP')SU.row=Math.max(0,SU.row-1);else if(ev==='DOWN')SU.row=Math.min(SROWS.length-1,SU.row+1);else if(ev==='EXIT'||ev==='EXE')G.app=G.prev;
    const m=/^F([1-3])$/.exec(ev);if(!m)return;const n=+m[1];
    if(SU.row===0)G.angle='DRG'[n-1];
    else if(n===3)G.fmt={type:'Norm',n:G.fmt.type==='Norm'&&G.fmt.n===1?2:1};
    else{const t=n===1?'Fix':'Sci';G.prompt={text:t+' [0~9]?',cb:d=>{G.fmt={type:t,n:d}}}}}};
/* ---------- keys ---------- */
const Dg=(n,al,sl)=>({l:String(n),al,sl,m:'t:'+n,a:al?'t:'+al:null,c:'num'});
const KEYS={
  F1:{l:'F1',sl:'Trace',m:'F1',s:'TRACE',c:'fk'},F2:{l:'F2',sl:'Zoom',m:'F2',s:'ZOOM',c:'fk'},F3:{l:'F3',sl:'V-Window',m:'F3',s:'VWIN',c:'fk'},F4:{l:'F4',sl:'Sketch',m:'F4',c:'fk'},F5:{l:'F5',sl:'G-Solv',m:'F5',s:'GSOLV',c:'fk'},F6:{l:'F6',sl:'G↔T',m:'F6',s:'GT',c:'fk'},
  shift:{l:'SHIFT',c:'k-shift'},optn:{l:'OPTN',m:'OPTN'},vars:{l:'VARS',sl:'PRGM',m:'VARS'},menu:{l:'MENU',sl:'SET UP',m:'MENU',s:'SETUP'},
  alpha:{l:'ALPHA',sl:'A-LOCK',c:'k-alpha'},sq:{l:'<i class="ser">x</i>²',sl:'√',al:'r',m:'t:²',s:'t:√'},pw:{l:'<span class="caret">∧</span>',sl:'ˣ√',al:'θ',m:'t:^',s:'t:ˣ√'},exit:{l:'EXIT',sl:'QUIT',m:'EXIT',s:'EXIT'},
  xt:{l:'X,<i class="ser">θ</i>,T',sl:'∠',al:'A',m:'t:X',a:'t:A'},log:{l:'log',sl:'10ˣ',al:'B',m:'t:log ',s:'t:10^',a:'t:B'},ln:{l:'ln',sl:'eˣ',al:'C',m:'t:ln ',s:'t:e^',a:'t:C'},
  sin:{l:'sin',sl:'sin⁻¹',al:'D',m:'t:sin ',s:'t:sin⁻¹ ',a:'t:D'},cos:{l:'cos',sl:'cos⁻¹',al:'E',m:'t:cos ',s:'t:cos⁻¹ ',a:'t:E'},tan:{l:'tan',sl:'tan⁻¹',al:'F',m:'t:tan ',s:'t:tan⁻¹ ',a:'t:F'},
  frac:{l:'<span class="kfrac"><i></i><i></i></span>',sl:'▪▫/▫',al:'G',m:'FRAC',s:'MIXFRAC',a:'t:G',aria:'fraction'},fd:{l:'S↔D',sl:'a b/c↔d/c',al:'H',m:'FD',a:'t:H'},lp:{l:'(',sl:'∛',al:'I',m:'t:(',s:'t:∛',a:'t:I'},rp:{l:')',sl:'x⁻¹',al:'J',m:'t:)',s:'t:⁻¹',a:'t:J'},comma:{l:',',al:'K',m:'t:,',a:'t:K'},sto:{l:'→',al:'L',m:'t:→',a:'t:L'},
  n7:Dg(7,'M','CAPTURE'),n8:Dg(8,'N','CLIP'),n9:Dg(9,'O','PASTE'),del:{l:'DEL',sl:'INS',al:'UNDO',m:'DEL',c:'k-del'},ac:{l:'AC<sup>/ON</sup>',sl:'OFF',m:'AC',s:'OFF',c:'k-del'},
  n4:Dg(4,'P','CATALOG'),n5:Dg(5,'Q'),n6:Dg(6,'R'),mul:{l:'×',sl:'{',al:'S',m:'t:×',a:'t:S',c:'num'},div:{l:'÷',sl:'}',al:'T',m:'t:÷',a:'t:T',c:'num'},
  n1:Dg(1,'U','List'),n2:Dg(2,'V','Mat'),n3:Dg(3,'W'),add:{l:'+',sl:'[',al:'X',m:'t:+',a:'t:X',c:'num'},sub:{l:'−',sl:']',al:'Y',m:'t:−',a:'t:Y',c:'num'},
  n0:Dg(0,'Z','i'),dot:{l:'•',sl:'=',al:'SPACE',m:'t:.',s:'t:=',c:'num'},exp:{l:'×10<sup><i class="ser">x</i></sup>',sl:'π',al:'”',m:'t:EE',s:'t:π',c:'num'},neg:{l:'(−)',sl:'Ans',m:'t:-',s:'t:Ans',c:'num'},exe:{l:'EXE',sl:'↵',m:'EXE',c:'num exe'},
  up:{l:'▲',m:'UP'},down:{l:'▼',m:'DOWN'},left:{l:'◀',m:'LEFT'},right:{l:'▶',m:'RIGHT'}};
const ROWS6=[['xt','log','ln','sin','cos','tan'],['frac','fd','lp','rp','comma','sto']];
const ROWS5=[['n7','n8','n9','del','ac'],['n4','n5','n6','mul','div'],['n1','n2','n3','add','sub'],['n0','dot','exp','neg','exe']];
function press(id){const k=KEYS[id];if(!k)return;
  if(id==='shift'){G.shift=!G.shift;G.alpha=false;return draw()}
  if(id==='alpha'){G.alpha=!G.alpha;G.shift=false;return draw()}
  const ev=G.shift&&k.s?k.s:G.alpha&&k.a?k.a:k.m;G.shift=G.alpha=false;blink=true;
  if(!ev)return draw();
  if(G.off){if(id==='ac')G.off=false;return draw()}
  if(ev==='OFF'){G.off=true;return draw()}
  if(G.msg){G.msg=null;return draw()}
  if(G.prompt){const m=/^t:(\d)$/.exec(ev);if(m){G.prompt.cb(+m[1]);G.prompt=null}else if(ev==='EXIT'||ev==='AC')G.prompt=null;return draw()}
  if(ev==='MENU')G.app='MENU';
  else if(ev==='SETUP'){if(G.app!=='SETUP'){G.prev=G.app;G.app='SETUP'}}
  else{try{APPS[G.app].key(ev)}catch(e){if(!(e instanceof CalcError))console.error(e);msg(e.kind||'Syntax ERROR')}}
  draw()}
function box(lines){const w=Math.max(...lines.map(l=>chars(l).length))+2,h=lines.length+2,x0=Math.floor((21-w)/2),y0=Math.floor((8-h)/2);
  c.fillStyle=BG;c.fillRect(x0*6*SC,y0*8*SC,w*6*SC,h*8*SC);c.strokeStyle=INK;c.lineWidth=SC;c.strokeRect(x0*6*SC+2,y0*8*SC+2,w*6*SC-4,h*8*SC-4);
  lines.forEach((l,k)=>txt(x0+1,y0+1+k,l))}
function wrap(s,n){const out=[];let cur='';s.split(' ').forEach(w=>{if((cur+' '+w).trim().length>n){out.push(cur);cur=w}else cur=(cur+' '+w).trim()});if(cur)out.push(cur);return out}
function draw(){if(!c)return;root.querySelector('#gx-shift').classList.toggle('lit',G.shift);root.querySelector('#gx-alpha').classList.toggle('lit',G.alpha);cls();if(G.off)return;
  APPS[G.app].draw();
  if(G.prompt)box([G.prompt.text]);
  if(G.msg)box(wrap(G.msg,17).concat(['Press:[EXIT]']));
  if(G.shift||G.alpha){txt(20,0,G.shift?'S':'A',true)}}
function keyBtn(id){const k=KEYS[id];return'<div class="kc"><div class="kl"><span class="sl">'+(k.sl||'')+'</span><span class="al">'+(k.al||'')+'</span></div><button type="button" class="key '+(k.c||'fn')+'" data-k="'+id+'" id="gx-'+id+'"'+(k.aria?' aria-label="'+k.aria+'"':'')+'>'+k.l+'</button></div>'}
function mount(el){root=el;
  let h='<div class="lcd gx-lcd"><canvas id="gx-canvas" width="512" height="256" role="img" aria-label="Graphing calculator screen"></canvas></div><div class="keys">';
  h+='<div class="grid6">'+['F1','F2','F3','F4','F5','F6'].map(keyBtn).join('')+'</div>';
  h+='<div class="grid6 top">'+keyBtn('shift')+keyBtn('optn')+keyBtn('vars')+keyBtn('menu')+'<div class="dpad" style="grid-row:span 2">'+['up','left','right','down'].map(d=>'<button type="button" class="key dp dp-'+d+'" data-k="'+d+'" id="gx-'+d+'" aria-label="'+d+'">'+KEYS[d].l+'</button>').join('')+'</div>';
  h+=keyBtn('alpha')+keyBtn('sq')+keyBtn('pw')+keyBtn('exit')+'</div>';
  h+='<div class="grid6">'+ROWS6.map(r=>r.map(keyBtn).join('')).join('')+'</div>';
  h+='<div class="grid5">'+ROWS5.map(r=>r.map(keyBtn).join('')).join('')+'</div></div>';
  el.innerHTML=h;cv=el.querySelector('canvas');c=cv.getContext('2d');
  el.addEventListener('click',e=>{const b=e.target.closest('[data-k]');if(b)press(b.dataset.k)});
  setInterval(()=>{blink=!blink;draw()},530);
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(draw);
  draw()}
const KB={Enter:'exe','=':'exe',Backspace:'del',Escape:'exit',Delete:'ac',ArrowUp:'up',ArrowDown:'down',ArrowLeft:'left',ArrowRight:'right','+':'add','-':'sub','*':'mul','/':'div','(':'lp',')':'rp','.':'dot','^':'pw',x:'xt',X:'xt',',':'comma',F1:'F1',F2:'F2',F3:'F3',F4:'F4',F5:'F5',F6:'F6'};
function keyboard(e){if(e.key==='='&&G.app==='EQUA'&&EQ.scr==='seq'){G.shift=true;press('dot');return true}
  let id=KB[e.key];if(/^\d$/.test(e.key))id='n'+e.key;if(!id)return false;press(id);return true}
return{mount,press,keyboard,G,R,GR,Y,EQ}})();
(function(){
  FX.mount(document.getElementById('fx'));GX.mount(document.getElementById('gx'));
  const us=document.getElementById('unit-sci'),ug=document.getElementById('unit-graph'),pick=document.getElementById('calc-pick');
  let active='sci';try{if(localStorage.getItem('calc')==='graph')active='graph'}catch(e){}
  const set=a=>{active=a;pick.value=a;us.hidden=a!=='sci';ug.hidden=a!=='graph';try{localStorage.setItem('calc',a)}catch(e){}};
  pick.addEventListener('change',()=>{set(pick.value);pick.blur()});set(active);
  document.addEventListener('keydown',e=>{if(e.ctrlKey||e.metaKey||e.altKey||e.target===pick)return;
    if(e.key==='Enter'&&document.activeElement&&document.activeElement.blur)document.activeElement.blur();
    if((active==='sci'?FX:GX).keyboard(e))e.preventDefault()});
})();
