<style>
/* Layout: a workbench. Short header, two devices side by side (stacked on phones). */
:root{
  --bg:#eef1f4;--surface:#ffffff;--fg:#18222d;--muted:#566473;--line:#cfd7df;--accent:#0f6e8c;
  --lcd:#c5d0bb;--lcd-ink:#17211c;
  --font-display:"Space Grotesk",system-ui,sans-serif;--font-body:"Inter",system-ui,sans-serif;--font-mono:"JetBrains Mono","DejaVu Sans Mono",Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#11171d;--surface:#1a222b;--fg:#e6ecf2;--muted:#9aa8b6;--line:#2c3844;--accent:#5cc0de;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#11171d;--surface:#1a222b;--fg:#e6ecf2;--muted:#9aa8b6;--line:#2c3844;--accent:#5cc0de;color-scheme:dark}
body{background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:15px;line-height:1.55;padding-block:28px 48px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.wrap{max-width:980px;margin:0 auto;display:flex;flex-direction:column;gap:24px}
h1{font-family:var(--font-display);font-size:28px;line-height:1.15;margin:0;text-wrap:balance}
h2{font-family:var(--font-display);font-size:17px;margin:0 0 6px}
header{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;justify-content:space-between}
.pick{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted)}
.pick select{font:500 14px var(--font-body);color:var(--fg);background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:7px 10px;max-width:100%}
.pick select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.bench{display:flex;flex-wrap:wrap;gap:28px 36px;justify-content:center;align-items:flex-start}
.unit{display:flex;flex-direction:column;gap:10px;width:min(100%,360px);min-width:0}
.unit-h{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.unit-h b{font-family:var(--font-display);font-size:15px}
.unit-h span{font-size:12px;color:var(--muted)}
.calc{border-radius:22px;padding:16px 14px 18px;background:var(--case);box-shadow:0 1px 0 rgba(255,255,255,.12) inset,0 10px 24px rgba(10,20,30,.22);outline:2px solid transparent;outline-offset:4px;transition:outline-color .15s}

.calc-sci{--case:#243342;--badge:#9fb2c4;--key:#40536a;--keyfg:#f2f6fa;--num:#e3e8ec;--numfg:#18222d;--del:#cf6a4a;--delfg:#fff;--shift:#f2bd62;--alpha:#ff9b8c}
.calc-graph{--case:#f7f7f5;--badge:#8b9096;--key:#ededeb;--keyfg:#1d2227;--num:#9c9ea0;--numfg:#ffffff;--del:#2a8db3;--delfg:#fff;--shift:#b98600;--alpha:#c4372b;--lcd:#e6f5f3;border:1px solid #d3d4d2;border-radius:30px;padding:18px 16px 22px}
.calc-graph .lcd{border:10px solid #707274;border-radius:14px}.calc-graph .gx-lcd{padding:4px}
.calc-graph .key{border:1px solid #b4b6b8;border-radius:5px;box-shadow:0 1px 0 #a4a6a8;font-size:12.5px;font-weight:500}
.calc-graph .key.num{border-color:#808284;font-size:21px;font-weight:400;height:38px}
.calc-graph .key.k-del{border-color:#1f7494;font-size:17px;font-weight:400;height:38px}
.calc-graph .key.exe{color:#12395c;font-size:17px;font-weight:600}
.calc-graph .key sup{font-size:.55em}.calc-graph .ser{font-family:Georgia,"Times New Roman",serif}.calc-graph .caret{font-size:15px;font-weight:700}
.kfrac{display:inline-flex;flex-direction:column;align-items:center;gap:2px;vertical-align:middle}.kfrac i{display:block;width:9px;height:5px;border:1.5px solid currentColor;border-radius:1px}.kfrac i:first-child{box-shadow:0 3.5px 0 -1.5px currentColor}
.calc-graph .dpad{position:relative;justify-self:center;align-self:center;aspect-ratio:1;height:100%;max-height:74px;padding:0;gap:0;background:#dededc;border-radius:12px}
.calc-graph .dpad::before,.calc-graph .dpad::after{content:"";position:absolute;clip-path:polygon(30% 0,70% 0,100% 30%,100% 70%,70% 100%,30% 100%,0 70%,0 30%)}
.calc-graph .dpad::before{inset:9%;background:#c3c5c6}.calc-graph .dpad::after{inset:30%;background:#e6e6e4}
.calc-graph .dp{position:relative;z-index:1;background:transparent;border:0;box-shadow:none;color:transparent;border-radius:6px}
.badge{font-family:var(--font-display);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--badge);margin:0 2px 8px}
.lcd{background:var(--lcd);color:var(--lcd-ink);border-radius:7px;border:3px solid #10161c;font-family:var(--font-mono)}
.fx-lcd{height:124px;padding:3px 9px 5px;display:flex;flex-direction:column;overflow:hidden}
.fx-ind{display:flex;gap:7px;font-size:9px;height:13px;line-height:13px;font-weight:700}
.fx-ind span{visibility:hidden}.fx-ind span.on{visibility:visible}
.fx-body{flex:1;display:flex;flex-direction:column;justify-content:space-between;min-height:0}
.fx-in{font-size:19px;white-space:nowrap;overflow:hidden;height:38px;line-height:38px;position:relative}
.fx-in .frac,.fx-out.sm .frac{vertical-align:middle;font-size:.68em}.mx{display:inline-flex;align-items:center;vertical-align:middle}.mx .frac{font-size:.68em}
.fx-in .frac>span{min-width:.7em;min-height:1.12em;text-align:center}.frac>span:empty::after,.mxw:empty::after{content:'▫'}
.fx-out{font-size:29px;font-weight:700;min-height:50px;display:flex;justify-content:flex-end;align-items:center;white-space:nowrap}
.fx-out.sm{font-size:18px;min-height:24px;font-weight:500}
.frac{display:inline-flex;flex-direction:column;align-items:center;font-size:.66em;line-height:1.12;margin:0 3px}
.frac>span:first-child{border-bottom:2px solid currentColor}.frac>span{padding:0 4px}
.unit[hidden]{display:none}
.cur{display:inline-block;width:2px;height:1.05em;background:currentColor;vertical-align:-3px;margin:0 -1px;animation:blink 1.06s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
@media (prefers-reduced-motion:reduce){.cur{animation:none}}
.x10{font-size:.68em}.ng{font-size:.8em;vertical-align:.12em}.lbl{margin-left:10px;font-weight:700}
.fx-menu{font:inherit;font-size:16.5px;line-height:1.28;margin:0;white-space:pre}.fx-menu .pg{font-size:11px}
.fx-tbl{border-collapse:collapse;font-size:13.5px;width:100%;table-layout:fixed}
.fx-tbl th{font-weight:700;width:auto}.fx-tbl th:first-child{width:22px}
.fx-tbl td{border:1px solid var(--lcd-ink);text-align:right;padding:0 4px;height:19px;overflow:hidden}
.fx-tbl td.sel{background:var(--lcd-ink);color:var(--lcd)}
.pair{font-size:18px;text-align:right;line-height:1.25}
.gx-lcd{padding:6px}.gx-lcd canvas{display:block;width:100%;height:auto;image-rendering:pixelated}
.keys{display:flex;flex-direction:column;gap:7px;margin-top:14px}
.grid6{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:3px 6px}
.grid5{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px 8px}
.kc{display:flex;flex-direction:column;min-width:0}
.kl{display:flex;justify-content:space-between;gap:2px;font-size:9px;font-weight:600;height:13px;line-height:13px;padding:0 1px;white-space:nowrap;overflow:hidden}
.sl{color:var(--shift)}.al{color:var(--alpha)}
.key{height:27px;border-radius:7px;border:0;padding:0;font-family:var(--font-body);font-size:11.5px;font-weight:600;cursor:pointer;background:var(--key);color:var(--keyfg);box-shadow:0 2px 0 rgba(0,0,0,.35);touch-action:manipulation;min-width:0}
.key:active{transform:translateY(2px);box-shadow:none}
.key:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.key.num{height:36px;font-size:17px;background:var(--num);color:var(--numfg)}
.key.k-del{height:36px;font-size:13px;background:var(--del);color:var(--delfg)}
.key.fk{height:22px;background:var(--key);color:var(--keyfg)}
.key.k-shift{background:var(--shift);color:#201400}.calc-graph .key.k-shift{background:var(--key);color:var(--shift)}
.key.k-alpha{background:var(--alpha);color:#2a0600}.calc-graph .key.k-alpha{background:var(--key);color:var(--alpha)}
.key.lit{box-shadow:0 0 0 2px var(--case),0 0 0 4px currentColor}
.dpad{grid-column:span 2;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);gap:2px;padding:4px 6px;align-self:stretch}
.dp{height:auto;font-size:9px;border-radius:5px}.dp-up{grid-area:1/2}.dp-left{grid-area:2/1}.dp-right{grid-area:2/3}.dp-down{grid-area:3/2}
@media (max-width:640px){</style>
<div class="wrap">
  <header>
    <h1>fx Calculator Simulators</h1>
    <label class="pick" for="calc-pick">Calculator <select id="calc-pick"><option value="sci">fx-82AU PLUS II (scientific)</option><option value="graph">fx-9860GIII (graphing)</option></select></label>
  </header>
  <div class="bench">
    <section class="unit" id="unit-sci"><div class="calc calc-sci"><div class="badge">Scientific · 2-line natural display</div><div id="fx"></div></div></section>
    <section class="unit" id="unit-graph" hidden><div class="calc calc-graph"><div class="badge">Graphing · 128 × 64</div><div id="gx"></div></div></section>
  </div>
</div>
<script>
'use strict';
/* ===== Shared maths engine ===== */
class CalcError extends Error{constructor(k){super(k);this.kind=k}}
const ME=()=>{throw new CalcError('Math ERROR')},SE=()=>{throw new CalcError('Syntax ERROR')};
const gcd=(a,b)=>{a=Math.abs(a);b=Math.abs(b);while(b){const t=a%b;a=b;b=t}return a};
const LIM=1e10,SAFE=4e15;
const isF=v=>typeof v==='object'&&v!==null;
const num=v=>isF(v)?v.n/v.d:v;
function fl(x){if(Number.isNaN(x)||!isFinite(x)||Math.abs(x)>=1e100)ME();return Math.abs(x)<1e-99?0:x}
function F(n,d=1){if(d===0)ME();if(d<0){n=-n;d=-d}const g=gcd(n,d)||1;n/=g;d/=g;if(Math.abs(n)>=LIM||d>=LIM)return fl(n/d);return{n:n||0,d}}
const I=x=>Number.isInteger(x)&&Math.abs(x)<LIM?F(x):fl(x);
function add(a,b){
  if(isF(a)&&isF(b)){const p=a.n*b.d,q=b.n*a.d,d=a.d*b.d;if(Math.abs(p)<SAFE&&Math.abs(q)<SAFE&&d<SAFE)return F(p+q,d)}
  const x=num(a),y=num(b),r=x+y;
  if(r!==0&&Math.abs(r)<1e-13*Math.max(Math.abs(x),Math.abs(y)))return 0;
  return fl(r)}
const neg=a=>isF(a)?{n:-a.n||0,d:a.d}:-a;
const sub=(a,b)=>add(a,neg(b));
function mul(a,b){if(isF(a)&&isF(b)){const n=a.n*b.n,d=a.d*b.d;if(Math.abs(n)<SAFE&&d<SAFE)return F(n,d)}return fl(num(a)*num(b))}
function div(a,b){if(num(b)===0)ME();if(isF(a)&&isF(b)){const n=a.n*b.d,d=a.d*b.n;if(Math.abs(n)<SAFE&&Math.abs(d)<SAFE)return F(n,d)}return fl(num(a)/num(b))}
function pow(a,b){const x=num(a),y=num(b);
  if(x===0){if(y<=0)ME();return F(0)}
  if(isF(b)&&b.d===1&&isF(a)&&Math.abs(b.n)<=400){let r=F(1),k=Math.abs(b.n),base=a;while(k){if(k&1)r=mul(r,base);k>>=1;if(k)base=mul(base,base)}return b.n<0?div(F(1),r):r}
  if(x<0){if(Number.isInteger(y))return fl(Math.pow(x,y));if(isF(b)&&b.d%2===1){const r=Math.pow(-x,y);return fl(b.n%2?-r:r)}ME()}
  return nice(Math.pow(x,y))}
function nice(x){x=fl(x);if(x===0)return 0;const r=parseFloat(x.toPrecision(14));return Number.isInteger(r)&&Math.abs(r)<LIM?F(r):x}
function sqrtv(a){const x=num(a);if(x<0)ME();if(isF(a)){const p=Math.round(Math.sqrt(a.n)),q=Math.round(Math.sqrt(a.d));if(p*p===a.n&&q*q===a.d)return F(p,q)}return Math.sqrt(x)}
function fact(a){const x=num(a);if(!Number.isInteger(x)||x<0||x>69)ME();let r=1;for(let k=2;k<=x;k++)r*=k;return I(r)}
function perm(a,b,comb){const n=num(a),r=num(b);if(!Number.isInteger(n)||!Number.isInteger(r)||r<0||r>n||n>=1e10)ME();
  let k=comb?Math.min(r,n-r):r;if(k>1e6)ME();let c=1;for(let j=1;j<=k;j++){c=comb?c*(n-k+j)/j:c*(n-j+1);if(c>=1e100)ME()}return I(Math.round(c))}

function evaluate(toks,ctx){
  let i=0;const vars=ctx.vars||{};ctx.pair=null;
  const peek=()=>toks[i];
  const isDig=t=>t!==undefined&&t.length===1&&((t>='0'&&t<='9')||t==='.');
  const close=()=>{if(peek()===')')i++;else if(peek()!==undefined)SE()};
  const A=ctx.angle||'D';
  const toR=x=>A==='D'?(x%360)*Math.PI/180:A==='G'?(x%400)*Math.PI/200:x;
  const frR=x=>A==='D'?x*180/Math.PI:A==='G'?x*200/Math.PI:x;
  const snap=x=>{x=fl(x);if(Math.abs(x)<1e-15)return F(0);x=parseFloat(x.toPrecision(15));for(const d of[1,2,4,5,10])if(Number.isInteger(x*d)&&Math.abs(x*d)<LIM)return F(x*d,d);return x};
  const one=a=>{if(a.length!==1)SE();return num(a[0])};
  const two=a=>{if(a.length!==2)SE();return[num(a[0]),num(a[1])]};
  const FN={
    sin:a=>snap(Math.sin(toR(one(a)))),cos:a=>snap(Math.cos(toR(one(a)))),
    tan:a=>{const r=toR(one(a));if(Math.abs(Math.cos(r))<1e-15)ME();return snap(Math.tan(r))},
    'sin⁻¹':a=>{const x=one(a);if(Math.abs(x)>1)ME();return snap(frR(Math.asin(x)))},
    'cos⁻¹':a=>{const x=one(a);if(Math.abs(x)>1)ME();return snap(frR(Math.acos(x)))},
    'tan⁻¹':a=>snap(frR(Math.atan(one(a)))),
    sinh:a=>snap(Math.sinh(one(a))),cosh:a=>snap(Math.cosh(one(a))),tanh:a=>snap(Math.tanh(one(a))),
    'sinh⁻¹':a=>snap(Math.asinh(one(a))),
    'cosh⁻¹':a=>{const x=one(a);if(x<1)ME();return snap(Math.acosh(x))},
    'tanh⁻¹':a=>{const x=one(a);if(Math.abs(x)>=1)ME();return snap(Math.atanh(x))},
    log:a=>{if(a.length===2){const[b,x]=two(a);if(b<=0||b===1||x<=0)ME();return snap(Math.log(x)/Math.log(b))}const x=one(a);if(x<=0)ME();return snap(Math.log10(x))},
    ln:a=>{const x=one(a);if(x<=0)ME();return snap(Math.log(x))},
    '10^':a=>{one(a);return pow(F(10),a[0])},'e^':a=>fl(Math.exp(one(a))),
    '√':a=>{one(a);return sqrtv(a[0])},
    '∛':a=>{const r=Math.cbrt(one(a));return Number.isInteger(r)?I(r):r},
    Abs:a=>{one(a);const v=a[0];return isF(v)?{n:Math.abs(v.n),d:v.d}:Math.abs(v)},
    Int:a=>I(Math.trunc(one(a))),Frac:a=>{const x=one(a);return sub(a[0],I(Math.trunc(x)))},
    Pol:a=>{const[x,y]=two(a);const r=Math.hypot(x,y),t=num(snap(frR(Math.atan2(y,x))));if('X'in vars){vars.X=r;vars.Y=t}ctx.pair=[['r',r],['θ',t]];return r},
    Rec:a=>{const[r,t]=two(a);const x=num(snap(r*Math.cos(toR(t)))),y=num(snap(r*Math.sin(toR(t))));if('X'in vars){vars.X=x;vars.Y=y}ctx.pair=[['X',x],['Y',y]];return x},
    'RanInt#':a=>{const[p,q]=two(a);if(!Number.isInteger(p)||!Number.isInteger(q)||p>q)ME();return I(p+Math.floor(Math.random()*(q-p+1)))},
    Rnd:a=>{const x=one(a);return ctx.rnd?ctx.rnd(x):x}
  };
  const BARE=['√','∛','e^','10^'];
  const preName=t=>{if(typeof t!=='string')return null;if(BARE.includes(t))return t;if(t.endsWith(' ')&&FN[t.slice(0,-1)])return t.slice(0,-1);return null};
  const parName=t=>typeof t==='string'&&t.length>1&&t.endsWith('(')&&FN[t.slice(0,-1)]?t.slice(0,-1):null;
  function number(){
    let s='';while(isDig(peek()))s+=toks[i++];
    let e=null;
    if(peek()==='EE'){i++;let sg='';if(peek()==='-'||peek()==='−'){i++;sg='-'}else if(peek()==='+')i++;let ds='';while(isDig(peek())&&peek()!=='.')ds+=toks[i++];if(!ds||ds.length>3)SE();e=parseInt(sg+ds)}
    if((s.match(/\./g)||[]).length>1||s==='.')SE();
    if(s==='')s='1';
    const x=parseFloat(s+(e!==null?'e'+e:''));
    const m=s.replace('.','');const k=s.includes('.')?s.length-s.indexOf('.')-1:0;const ee=(e||0)-k;
    if(m.length<=15){let n=parseInt(m),d=1;if(ee>=0&&ee<16)n*=10**ee;else if(ee<0&&ee>-16)d=10**(-ee);else return fl(x);if(Number.isSafeInteger(n))return F(n,d)}
    return fl(x)}
  function special(t){if(ctx.special){const v=ctx.special(t,true);if(v!==undefined)return true}return false}
  function startsPrimary(t,noFn){
    if(t===undefined)return false;
    if(t==='('||t==='π'||t==='econ'||t==='Ans'||t==='Ran#'||t==='EE'||isDig(t))return true;
    if(Object.prototype.hasOwnProperty.call(vars,t))return true;
    if(parName(t)||preName(t))return !noFn;
    return special(t)}
  function primary(){
    const t=peek();if(t===undefined)SE();
    if(isDig(t)||t==='EE')return number();
    i++;
    if(t==='('){const v=expr();close();return v}
    const pn=parName(t);
    if(pn){const args=[expr()];while(peek()===','){i++;args.push(expr())}close();return FN[pn](args)}
    const pr=preName(t);
    if(pr)return FN[pr]([implied(true)]);
    if(t==='π')return Math.PI;if(t==='econ')return Math.E;
    if(t==='Ans')return ctx.ans;
    if(t==='Ran#')return F(Math.floor(Math.random()*1000),1000);
    if(Object.prototype.hasOwnProperty.call(vars,t))return vars[t];
    if(ctx.special){const v=ctx.special(t);if(v!==undefined)return v}
    SE()}
  function powOperand(){if(peek()==='-'||peek()==='−'){i++;return neg(powOperand())}return primary()}
  function postfix(){
    let v=primary();
    for(;;){const t=peek();
      if(t==='²'){i++;v=mul(v,v)}
      else if(t==='³'){i++;v=mul(v,mul(v,v))}
      else if(t==='⁻¹'){i++;v=div(F(1),v)}
      else if(t==='!'){i++;v=fact(v)}
      else if(t==='%'){i++;v=div(v,F(100))}
      else if(t==='^('){i++;const e=expr();close();v=pow(v,e)}
      else if(t==='^'){i++;v=pow(v,powOperand())}
      else if(t==='ˣ√('){i++;const r=expr();close();v=pow(r,div(F(1),v))}
      else if(t==='ˣ√'){i++;v=pow(powOperand(),div(F(1),v))}
      else if(t==='°'){i++;const p=[v];while(isDig(peek())&&p.length<3){p.push(number());if(peek()==='°')i++;else SE()}
        v=p[0];if(p[1]!==undefined)v=add(v,div(p[1],F(60)));if(p[2]!==undefined)v=add(v,div(p[2],F(3600)))}
      else if(t==='⌟'){i++;const b=primary();if(peek()==='⌟'){i++;const c=primary();v=add(v,div(b,c))}else v=div(v,b)}
      else if(ctx.post&&ctx.post[t]){i++;v=ctx.post[t](num(v))}
      else return v}}
